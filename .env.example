APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://contract:contract@postgres:5432/contract_review
POSTGRES_DB=contract_review
POSTGRES_USER=contract
POSTGRES_PASSWORD=contract
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_AFTER_SECONDS=120
WORKER_MAX_CONCURRENT_TASKS=1
TASK_MAX_ATTEMPTS=2
MOCK_STAGE_DELAY_SECONDS=0.15
TEMP_ROOT=/tmp/contract-review
MAX_FILE_SIZE_MB=200
MAX_REFERENCE_FILES=20
DOWNLOAD_TIMEOUT_SECONDS=120
DOWNLOAD_MAX_REDIRECTS=3
PDF_MIN_TEXT_CHARS_PER_PAGE=20
ALLOW_HTTP_DOWNLOADS=false
DOWNLOAD_HOST_ALLOWLIST=
LOCAL_FIXTURE_DIR=./local-fixtures
OCR_ENABLED=false
OCR_BASE_URL=
OCR_API_KEY=
OCR_AUTH_HEADER=
OCR_TIMEOUT_SECONDS=600
OCR_MAX_RESPONSE_MB=50
OCR_HTTP_RETRY_ATTEMPTS=2
OCR_RETRY_BACKOFF_SECONDS=0.5
OCR_LOW_CONFIDENCE_THRESHOLD=0.8
LLM_ENABLED=false
LLM_PROTOCOL=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_EXTRACTION_MODEL=GLM-5.2
LLM_REVIEW_MODEL=GLM-5.2-reviewer
LLM_ADVICE_MODEL=GLM-5.2
LLM_EMBEDDING_MODEL=embedding
LLM_RERANK_MODEL=rerank
LLM_TIMEOUT_SECONDS=300
LLM_MAX_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CHUNK_MAX_CHARS=12000
LLM_STRUCTURE_RETRY_ATTEMPTS=2
LLM_CONSENSUS_MIN_CONFIDENCE=0.85
LLM_REQUIRE_INDEPENDENT_MODEL=true
LLM_NATIVE_STRUCTURED_OUTPUT=false
LLM_ENABLE_EMBEDDING=false
LLM_ENABLE_RERANK=false
RESULT_SCHEMA_VERSION=2.1
WORKFLOW_VERSION=0.1.0
RULES_VERSION=0.1.0
